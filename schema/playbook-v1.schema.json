{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/relux-works/curator-playbook/schema/playbook-v1.schema.json",
  "title": "Playbook.json (draft v2, schema_version 1)",
  "description": "Process configuration for agent systems. DRAFT v2, not normative; see spec/process-configuration.md. A playbook is data only: it never names a program, script, webhook or URL (spec section 8.5). Keys starting with x- are reserved for extensions and ignored by the kernel.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/identifier",
      "description": "Playbook name. Required for a published template; optional in a project file."
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "description": "Single parent playbook (spec section 7.1). The object form pins the parent package identity (repository and tag), which the resolver checks against the installed lock.",
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/identifier"
            },
            "package": {
              "type": "string",
              "description": "Package identity, for example relux-works/curator-playbook-dev-cycle@v1.0.0."
            }
          }
        }
      ]
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true,
      "description": "Composition of several playbooks into one process (spec section 7.2)."
    },
    "slots": {
      "type": "object",
      "description": "Abstract element types this playbook refers to without defining them; a composing project binds each slot to a concrete type.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "bind": {
      "type": "object",
      "description": "Bindings in a composing project: key is <playbook>.<slot> (or <slot> when unambiguous); value is a concrete entity type, or for a process slot a playbook name of the composition (spec sections 6.5, 7.2).",
      "propertyNames": {
        "type": "string",
        "pattern": "^([a-z][a-z0-9-]*\\.)?[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/qualified"
      }
    },
    "root": {
      "$ref": "#/$defs/identifier",
      "description": "Role alias of the orchestrator that owns this process."
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "tools": {
      "type": "object",
      "description": "Tool names bound to commands exported by installed skills (spec section 8.5). A published template may bind only to skills of its own package; every other binding comes from the project file.",
      "propertyNames": {
        "$ref": "#/$defs/hook-name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/tool-binding"
      }
    },
    "people": {
      "type": "object",
      "description": "Human groups named by human roles (who), mapped to waggle roster principals (spec section 4.2). Defined by the project file.",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/people-group"
      }
    },
    "events": {
      "type": "object",
      "description": "External events this playbook reacts to, with the principals allowed to sign them (spec section 6.9).",
      "propertyNames": {
        "$ref": "#/$defs/hook-name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/event-declaration"
      }
    },
    "entities": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "workflows": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workflow"
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/schedule"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "ui": {
      "$ref": "#/$defs/ui"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "field-name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "Field names use snake_case, like task-board's task_class."
    },
    "qualified": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]*\\.)?[a-z][a-z0-9-]*$",
      "description": "A name, optionally qualified by its playbook when a composition makes it ambiguous."
    },
    "hook-name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "maxLength": 96
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
      "description": "ISO 8601 duration, for example PT15M or P1W."
    },
    "ui": {
      "type": "object",
      "description": "Layout and presentation hints for a visual constructor. Ignored by the kernel and excluded from the semantic digest."
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "kind": {
          "enum": [
            "type",
            "process"
          ],
          "default": "type",
          "description": "type: an entity type the project binds; process: a receiving process the project binds to a playbook of the composition or another board."
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "estimates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field-name"
              },
              "uniqueItems": true
            },
            "terminal": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "uniqueItems": true
            }
          },
          "description": "Contract the bound type must satisfy: named estimate dimensions, fields, terminal states."
        }
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "description": "A requirement or preference stated in portable terms; never a concrete model id, runtime or effort (effort lives in the operator file; a project may set a floor in policy.effort_floor).",
      "properties": {
        "publisher": {
          "$ref": "#/$defs/string-or-list"
        },
        "family": {
          "$ref": "#/$defs/string-or-list"
        },
        "capability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "local": {
          "type": "boolean"
        },
        "not_same_publisher_as": {
          "$ref": "#/$defs/identifier",
          "description": "Independence: differ from the publisher bound to that role alias."
        }
      }
    },
    "string-or-list": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require": {
          "$ref": "#/$defs/need"
        },
        "prefer": {
          "$ref": "#/$defs/need"
        },
        "on_unmet": {
          "enum": [
            "block",
            "fallback",
            "ask",
            "degrade"
          ]
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/need"
          },
          "minItems": 1
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "oneOf": [
                {
                  "enum": [
                    "element",
                    "project"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ancestor"
                  ],
                  "properties": {
                    "ancestor": {
                      "$ref": "#/$defs/qualified"
                    }
                  },
                  "description": "The nearest ancestor of this type."
                }
              ]
            },
            "expires": {
              "$ref": "#/$defs/duration"
            }
          },
          "description": "Proposed defaults for an ask approval; the approval binds to the approving principal and that principal's own runs (spec section 9)."
        },
        "degraded_state": {
          "$ref": "#/$defs/identifier",
          "description": "degrade: the statically declared review state the degraded path goes through (spec section 9)."
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "human",
            "tool",
            "process"
          ],
          "default": "agent"
        },
        "skill": {
          "$ref": "#/$defs/identifier",
          "description": "agent: the role skill, by installed skill name."
        },
        "who": {
          "$ref": "#/$defs/identifier",
          "description": "human: a group of the project people map."
        },
        "tool": {
          "$ref": "#/$defs/hook-name",
          "description": "tool: a tool name bound in the tools map to a command exported by an installed skill."
        },
        "process": {
          "$ref": "#/$defs/qualified",
          "description": "process: the receiving process, a playbook of the composition or a process slot the project binds."
        },
        "capability": {
          "anyOf": [
            {
              "enum": [
                "orchestrator",
                "producer",
                "reviewer",
                "analyst",
                "tester",
                "approver",
                "checker"
              ]
            },
            {
              "type": "string",
              "pattern": "^x-[a-z0-9-]+$"
            }
          ]
        },
        "needs": {
          "$ref": "#/$defs/needs"
        },
        "description": {
          "type": "string"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "who"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "skill"
                  ]
                },
                {
                  "required": [
                    "needs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "tool"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "skill"
                  ]
                },
                {
                  "required": [
                    "needs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "process"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "skill"
                  ]
                },
                {
                  "required": [
                    "needs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "kind"
              ]
            }
          },
          "then": {
            "required": [
              "skill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "skill"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "human"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "anyOf": [
                  {
                    "const": "approver"
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "anyOf": [
                  {
                    "const": "checker"
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "capability"
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "capability": {
                "anyOf": [
                  {
                    "enum": [
                      "orchestrator",
                      "producer",
                      "reviewer",
                      "analyst",
                      "tester"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "text",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "duration",
            "money",
            "enum",
            "ref",
            "list"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "of": {
          "type": "string",
          "description": "list: the item type (a field type name, or an entity type for ref items)."
        },
        "ref": {
          "$ref": "#/$defs/qualified",
          "description": "ref: the referenced entity type."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            }
          },
          "then": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "of"
            ]
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scale"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "scale": {
          "enum": [
            "fibonacci",
            "points",
            "tshirt",
            "hours",
            "days"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "root": {
          "type": "boolean",
          "description": "May stand at the top of the hierarchy."
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualified"
          },
          "uniqueItems": true
        },
        "contains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualified"
          },
          "uniqueItems": true
        },
        "workflow": {
          "$ref": "#/$defs/qualified"
        },
        "derived_status": {
          "type": "boolean",
          "description": "Status aggregates from children by the kernel; aggregated moves are not transitions (spec section 5.1)."
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/field-name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/estimate"
          }
        },
        "privacy": {
          "enum": [
            "inherit",
            "private",
            "team",
            "public"
          ]
        },
        "description": {
          "type": "string"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        },
        "members": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/qualified"
            },
            "max_per_item": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string"
            }
          },
          "description": "Membership by link, not containment: the hierarchy stays a tree (spec section 7.2)."
        }
      }
    },
    "owner": {
      "oneOf": [
        {
          "$ref": "#/$defs/qualified"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "one_of",
            "by"
          ],
          "properties": {
            "one_of": {
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/qualified"
                  },
                  "minItems": 2,
                  "uniqueItems": true
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "capability"
                  ],
                  "properties": {
                    "capability": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "description": "Any installed agent role with one of these capabilities (today's open-ended roles)."
                }
              ]
            },
            "by": {
              "const": "assignment.role",
              "description": "The structured role alias recorded by assignment or spawn."
            }
          },
          "description": "Each element has exactly one owner in each state; the state admits several roles and assignment picks one. Until assignment the root orchestrator owns the element (spec section 6.1)."
        }
      ]
    },
    "helper": {
      "oneOf": [
        {
          "$ref": "#/$defs/qualified"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role"
          ],
          "properties": {
            "role": {
              "$ref": "#/$defs/qualified"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "blind": {
              "type": "boolean",
              "description": "Helpers answer independently before the owner reveals answers (planning poker)."
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "helpers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/helper"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard-hook"
          },
          "description": "Entry conditions: guards applied to every transition into this state, and to creation when the state is initial."
        },
        "terminal": {
          "type": "boolean"
        },
        "resolution": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "locked": {
          "type": "boolean",
          "description": "Only transitions that name this state in from leave it; from * never matches it."
        },
        "remove": {
          "type": "boolean",
          "description": "In a file that extends a parent: delete the inherited state."
        },
        "description": {
          "type": "string"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        }
      },
      "if": {
        "properties": {
          "terminal": {
            "const": true
          }
        },
        "required": [
          "terminal"
        ]
      },
      "then": {
        "not": {
          "required": [
            "owner"
          ]
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/hook-name",
          "description": "A kernel, module, tool or declared external event (spec sections 6.3, 6.9)."
        },
        "after": {
          "$ref": "#/$defs/duration"
        }
      },
      "oneOf": [
        {
          "required": [
            "event"
          ]
        },
        {
          "required": [
            "after"
          ]
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "oneOf": [
            {
              "const": "*"
            },
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/identifier"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "via": {
          "$ref": "#/$defs/hook-name",
          "description": "The one command that performs this from-to pair, for example accept_cr; it does not restrict other pairs into the same state."
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard-hook"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action-hook"
          }
        },
        "on": {
          "$ref": "#/$defs/trigger"
        },
        "limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max",
            "then"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "then": {
              "$ref": "#/$defs/identifier"
            },
            "resolution": {
              "$ref": "#/$defs/identifier",
              "description": "Resolution recorded when the redirect enters a resolution state."
            }
          },
          "description": "Loop limit: after max firings for one element, the transition leads to then instead."
        },
        "reopen": {
          "type": "boolean",
          "description": "Required for a transition that leaves a terminal state."
        },
        "remove": {
          "type": "boolean",
          "description": "In a file that extends a parent: delete the inherited transition with the same from and to."
        },
        "description": {
          "type": "string"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        },
        "resolution": {
          "$ref": "#/$defs/identifier",
          "description": "Resolution this transition records on entry; required for automatic transitions into a resolution state."
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "initial": {
          "$ref": "#/$defs/identifier",
          "description": "The state an element enters on creation; creation is subject to its requires."
        },
        "states": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "description": {
          "type": "string"
        },
        "ui": {
          "$ref": "#/$defs/ui"
        },
        "migrations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Old state name to new state name, applied to existing elements when a template update removes or renames a state (spec section 7.1)."
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "create"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "every": {
          "$ref": "#/$defs/duration"
        },
        "cron": {
          "type": "string"
        },
        "create": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/qualified"
            },
            "title": {
              "type": "string"
            },
            "parent": {
              "type": "string"
            },
            "fields": {
              "type": "object"
            }
          }
        },
        "description": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "every"
          ]
        },
        {
          "required": [
            "cron"
          ]
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      },
      "properties": {
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": {
              "enum": [
                "required",
                "light",
                "none"
              ]
            }
          }
        },
        "capacity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "container",
              "dimension",
              "max"
            ],
            "properties": {
              "container": {
                "$ref": "#/$defs/qualified"
              },
              "dimension": {
                "$ref": "#/$defs/identifier"
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visibility": {
              "enum": [
                "private",
                "team",
                "public"
              ]
            },
            "redact_fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field-name"
              },
              "uniqueItems": true
            }
          }
        },
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "orchestrator_goal": {
              "oneOf": [
                {
                  "$ref": "#/$defs/qualified"
                },
                {
                  "type": "object",
                  "propertyNames": {
                    "$ref": "#/$defs/qualified"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/qualified"
                  },
                  "description": "Per orchestrator role: the entity type whose current instance is its goal."
                }
              ]
            }
          }
        },
        "effort_floor": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/qualified"
          },
          "additionalProperties": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "description": "Project only: the lowest reasoning effort a role may run at; the operator file chooses within it."
        },
        "enable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedules": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/qualified"
                  },
                  "uniqueItems": true
                }
              ]
            },
            "auto_spawn": {
              "type": "boolean"
            },
            "relaxations": {
              "type": "boolean",
              "description": "Accept the fallback and degrade policies the admitted playbooks propose."
            }
          },
          "description": "Project only: side effects a package may propose but only the project turns on (spec section 8.5)."
        },
        "signatures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_for": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "anyOf": [
                  {
                    "enum": [
                      "approvals",
                      "spending",
                      "halts",
                      "relaxations",
                      "human-transitions"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^x-[a-z0-9-]+$"
                  }
                ]
              }
            },
            "min_assurance": {
              "enum": [
                "software",
                "hardware-bound",
                "attested"
              ]
            }
          },
          "description": "Which human acts need a waggle approver signature, and at what key assurance (spec section 4.2)."
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_control": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "confirm": {
                  "type": "boolean"
                },
                "desired_commit_time": {
                  "type": "string"
                },
                "commit_time_policy": {
                  "type": "string"
                }
              },
              "if": {
                "properties": {
                  "confirm": {
                    "const": true
                  }
                },
                "required": [
                  "confirm"
                ]
              },
              "then": {
                "required": [
                  "desired_commit_time"
                ]
              }
            },
            "loop_detection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "floor": {
                  "type": "integer",
                  "minimum": 1
                },
                "factor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "description": "Threshold = max(floor, factor x median rework)."
            }
          },
          "description": "Delivery-module policy (development only; spec section 6.10)."
        }
      }
    },
    "tool-binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill",
        "command"
      ],
      "properties": {
        "skill": {
          "$ref": "#/$defs/identifier",
          "description": "Installed skill that exports the command (audited through Curator)."
        },
        "command": {
          "$ref": "#/$defs/identifier",
          "description": "A command the skill manifest exports; never a free-form program string."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "people-group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principals"
      ],
      "properties": {
        "principals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[^\\s@]+@[^\\s@]+$"
          },
          "description": "waggle roster principals or principal patterns, for example op:alice@acme or op:*@acme."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "event-declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Principals (or tool keys) whose signature makes a posted event valid."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "guard-hook": {
      "description": "A guard reference: a name, or an object whose guard key names it and whose other keys are its arguments (spec section 6.3).",
      "oneOf": [
        {
          "$ref": "#/$defs/hook-name"
        },
        {
          "type": "object",
          "required": [
            "guard"
          ],
          "not": {
            "required": [
              "action"
            ]
          },
          "properties": {
            "guard": {
              "$ref": "#/$defs/hook-name"
            },
            "applies_to": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actor": {
                  "enum": [
                    "run",
                    "human",
                    "any"
                  ]
                },
                "except_capability": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              },
              "description": "Limit the guard to one actor class (spec section 4.2)."
            }
          }
        }
      ]
    },
    "action-hook": {
      "description": "An action reference: a name, or an object whose action key names it and whose other keys are its arguments (spec section 6.3).",
      "oneOf": [
        {
          "$ref": "#/$defs/hook-name"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "not": {
            "required": [
              "guard"
            ]
          },
          "properties": {
            "action": {
              "$ref": "#/$defs/hook-name"
            }
          }
        }
      ]
    }
  }
}
