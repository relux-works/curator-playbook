{
  "$schema": "../../schema/playbook-v1.schema.json",
  "schema_version": 1,
  "name": "cafe-ops",
  "description": "Running a small cafe: a weekly inventory creates purchase orders; a person approves spending and confirms deliveries; the supplier portal is a tool (a command of a provider skill that the orchestrator skill declares as a runtime dependency); supplier events arrive signed by a bridge the project binds; invoices are offered to the accounting process, which returns when the invoice is paid or rejected. Exercises custom fields, human and tool owners, timers, recurrence, external events, parallel lines with a join, a loop limit, hand-off and per-process privacy. The tool, the schedule and the automatic spawns take effect only when the project enables them.",
  "root": "cafe-orchestrator",
  "slots": {
    "accounting-process": { "kind": "process", "description": "The process that books and pays invoices." },
    "invoice": { "description": "The invoice type of the accounting process.", "requires": { "terminal": ["paid", "rejected"] } }
  },
  "roles": {
    "cafe-orchestrator": { "skill": "cafe-orchestrator", "capability": "orchestrator" },
    "stock-keeper": { "skill": "cafe-stock-keeper", "capability": "producer", "needs": { "prefer": { "local": true } } },
    "buyer": { "skill": "cafe-buyer", "capability": "producer" },
    "manager": { "kind": "human", "who": "cafe-managers", "capability": "approver" },
    "supplier-portal": { "kind": "tool", "tool": "supplier.send-order", "capability": "checker" },
    "accounting": { "kind": "process", "process": "accounting-process" }
  },
  "tools": {
    "supplier.send-order": {
      "skill": "cafe-supplier-portal",
      "command": "cafe-send-order",
      "timeout": "PT2M",
      "description": "Provider skill in tools/supplier-portal of the package, outside the skills collection; the orchestrator's manifest depends on it in runtime mode narrowed to cafe-send-order. The kernel's tool executor runs it when a purchase order enters sending."
    }
  },
  "events": {
    "supplier.confirmed": { "signed_by": "supplier-bridge", "description": "The supplier accepted the order." },
    "supplier.shipped": { "signed_by": "supplier-bridge" }
  },
  "entities": {
    "inventory-check": {
      "root": true,
      "contains": ["purchase-order"],
      "workflow": "inventory",
      "fields": {
        "low_items": { "type": "list", "of": "string", "description": "Items under their reorder level." }
      }
    },
    "purchase-order": {
      "parents": ["inventory-check"],
      "contains": ["line"],
      "workflow": "purchase",
      "fields": {
        "item": { "type": "string", "description": "The low item this order was created for." },
        "supplier": { "type": "string", "required": true },
        "amount": { "type": "money", "currency": "EUR", "required": true },
        "due": { "type": "date" },
        "invoice": { "type": "ref", "ref": "invoice" }
      }
    },
    "line": {
      "parents": ["purchase-order"],
      "workflow": "line",
      "fields": {
        "item": { "type": "string", "required": true },
        "quantity": { "type": "number", "required": true }
      }
    }
  },
  "workflows": {
    "inventory": {
      "initial": "open",
      "states": {
        "open": { "owner": "cafe-orchestrator" },
        "counting": { "owner": "stock-keeper" },
        "approval": { "owner": "manager" },
        "done": { "terminal": true }
      },
      "transitions": [
        { "from": "open", "to": "counting", "actions": ["spawn.owner"] },
        { "from": "counting", "to": "approval", "guards": [{ "guard": "fields.present", "fields": ["low_items"] }] },
        {
          "from": "approval",
          "to": "done",
          "guards": [{ "guard": "approvals", "role": "manager", "min": 1 }],
          "actions": [{ "action": "create", "type": "purchase-order", "per": "low_items", "fields": { "item": "$item" } }]
        }
      ]
    },
    "purchase": {
      "initial": "draft",
      "states": {
        "draft": { "owner": "buyer", "description": "Supplier and amount are required before the order leaves draft." },
        "approval": { "owner": "manager" },
        "sending": { "owner": "supplier-portal", "description": "The tool places the order with the supplier portal." },
        "awaiting-confirmation": { "owner": "cafe-orchestrator", "description": "The order is placed; the supplier has fifteen minutes to confirm." },
        "escalated": { "owner": "manager", "description": "The portal failed, the supplier did not confirm in time, approval kept being refused, or accounting rejected the invoice." },
        "confirmed": { "owner": "cafe-orchestrator" },
        "receiving": { "owner": "manager", "description": "A person checks each delivered line." },
        "invoiced": { "owner": "accounting" },
        "paid": { "terminal": true },
        "cancelled": { "terminal": true, "resolution": ["supplier-declined", "not-needed"] }
      },
      "transitions": [
        { "from": "draft", "to": "approval" },
        {
          "from": "approval",
          "to": "draft",
          "guards": [{ "guard": "verdict", "is": "changes_requested" }],
          "limit": { "max": 2, "then": "escalated" }
        },
        {
          "from": "approval",
          "to": "sending",
          "risk": "spending",
          "guards": [{ "guard": "approvals", "role": "manager", "min": 1 }],
          "description": "Entering sending places the order, so the move is marked as spending."
        },
        { "from": "sending", "to": "awaiting-confirmation", "on": { "event": "tool.passed" } },
        { "from": "sending", "to": "escalated", "on": { "event": "tool.failed" } },
        { "from": "awaiting-confirmation", "to": "confirmed", "on": { "event": "supplier.confirmed" } },
        { "from": "awaiting-confirmation", "to": "escalated", "on": { "after": "PT15M" } },
        {
          "from": "escalated",
          "to": "sending",
          "risk": "spending",
          "guards": [{ "guard": "approvals", "role": "manager", "min": 1 }],
          "description": "Sending again needs a new approval: the one recorded before the first send is not fresh (spec section 6.3)."
        },
        {
          "from": "escalated",
          "to": "confirmed",
          "on": { "event": "supplier.confirmed" },
          "description": "A confirmation that arrives after the SLA fired is not lost: it is retained and moves the order on (spec section 6.9)."
        },
        { "from": "confirmed", "to": "receiving", "on": { "event": "supplier.shipped" } },
        {
          "from": "receiving",
          "to": "invoiced",
          "guards": ["children.terminal"],
          "actions": [{ "action": "handoff", "to": "accounting", "create": "invoice", "link_field": "invoice" }]
        },
        {
          "from": "invoiced",
          "to": "paid",
          "on": { "event": "process.returned" },
          "guards": [{ "guard": "process.result", "in": ["paid"] }]
        },
        {
          "from": "invoiced",
          "to": "escalated",
          "on": { "event": "process.returned" },
          "guards": [{ "guard": "process.result", "in": ["rejected"] }]
        },
        { "from": "*", "to": "cancelled", "description": "From a tool- or process-owned state only a human may cancel (an override)." }
      ]
    },
    "line": {
      "initial": "expected",
      "states": {
        "expected": { "owner": "manager" },
        "received": { "terminal": true },
        "missing": { "terminal": true, "resolution": ["short", "damaged", "wrong-item"] }
      },
      "transitions": [
        { "from": "expected", "to": "received" },
        { "from": "expected", "to": "missing" }
      ]
    }
  },
  "schedules": [
    { "name": "weekly-inventory", "every": "P1W", "create": { "type": "inventory-check", "title": "Weekly inventory" } }
  ],
  "policy": {
    "privacy": { "visibility": "team", "redact_fields": ["amount"] }
  }
}
