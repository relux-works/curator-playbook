{
  "$schema": "../../schema/playbook-v1.schema.json",
  "schema_version": 1,
  "name": "scrum",
  "description": "A cadence layer: it decides which work is selected and when, not how an item is built. Work items stay in their delivery hierarchy; a sprint holds them by membership link, so the hierarchy remains a tree. The work item and the delivery process are slots the project binds, for example to dev-cycle's story and to dev-cycle itself.",
  "root": "scrum-orchestrator",
  "slots": {
    "work-item": {
      "description": "Backlog item planned into sprints. It lives in the delivery process's hierarchy; binding this slot delegates to the scrum orchestrator exactly the two estimate fields it writes during grooming.",
      "requires": { "estimates": ["complexity", "duration"], "terminal": ["done", "closed"] },
      "writes": { "estimates": ["complexity", "duration"] }
    },
    "delivery": {
      "kind": "process",
      "description": "The delivery process that receives improvement items from retrospectives and places them in its own hierarchy."
    }
  },
  "roles": {
    "scrum-orchestrator": { "skill": "scrum-orchestrator", "capability": "orchestrator" },
    "product-owner": { "skill": "scrum-product-owner", "capability": "analyst", "description": "Ranks the backlog against the goal and links the selected items to the sprint." },
    "facilitator": { "skill": "scrum-facilitator", "capability": "analyst" },
    "estimator": { "skill": "scrum-estimator", "capability": "analyst" },
    "sponsor": { "kind": "human", "who": "sponsors", "capability": "approver" },
    "delivery-process": { "kind": "process", "process": "delivery" }
  },
  "entities": {
    "goal": {
      "root": true,
      "contains": ["milestone"],
      "workflow": "goal",
      "fields": { "target_date": { "type": "date" } }
    },
    "milestone": { "parents": ["goal"], "contains": ["sprint"], "workflow": "milestone" },
    "sprint": {
      "parents": ["milestone"],
      "contains": ["grooming", "planning", "retro"],
      "members": { "type": "work-item", "max_per_item": 1, "description": "Links stored on the sprint, inside the scrum orchestrator's scope; an item belongs to at most one open sprint, and carrying it over relinks it." },
      "workflow": "sprint",
      "fields": { "velocity": { "type": "number", "description": "Complexity points accepted, written by the retro." } }
    },
    "grooming": { "parents": ["sprint"], "workflow": "grooming" },
    "planning": { "parents": ["sprint"], "workflow": "planning" },
    "retro": { "parents": ["sprint"], "workflow": "retro" }
  },
  "workflows": {
    "goal": {
      "initial": "open",
      "states": {
        "open": { "owner": "sponsor", "requires": ["description"] },
        "active": { "owner": "scrum-orchestrator" },
        "achieved": { "terminal": true },
        "abandoned": { "terminal": true, "resolution": true }
      },
      "transitions": [
        { "from": "open", "to": "active" },
        { "from": "active", "to": "achieved", "guards": ["children.terminal", { "guard": "approvals", "role": "sponsor", "min": 1 }] },
        { "from": "*", "to": "abandoned" }
      ]
    },
    "milestone": {
      "initial": "planned",
      "states": {
        "planned": { "owner": "product-owner" },
        "active": { "owner": "scrum-orchestrator" },
        "done": { "terminal": true },
        "dropped": { "terminal": true, "resolution": true }
      },
      "transitions": [
        { "from": "planned", "to": "active" },
        { "from": "active", "to": "done", "guards": ["children.terminal"] },
        { "from": "*", "to": "dropped" }
      ]
    },
    "sprint": {
      "initial": "planned",
      "states": {
        "planned": { "owner": "scrum-orchestrator" },
        "active": { "owner": "scrum-orchestrator" },
        "review": { "owner": "sponsor" },
        "retrospective": { "owner": "facilitator" },
        "closed": { "terminal": true }
      },
      "transitions": [
        {
          "from": "planned",
          "to": "active",
          "guards": [{ "guard": "children.terminal", "types": ["grooming", "planning"] }, { "guard": "capacity", "dimension": "complexity" }]
        },
        { "from": "active", "to": "review", "guards": ["members.terminal-or-carried"] },
        { "from": "review", "to": "retrospective" },
        { "from": "retrospective", "to": "closed", "guards": [{ "guard": "children.terminal", "types": ["retro"] }] }
      ]
    },
    "grooming": {
      "initial": "open",
      "states": {
        "open": { "owner": "scrum-orchestrator" },
        "estimating": {
          "owner": "facilitator",
          "helpers": [{ "role": "estimator", "min": 3, "blind": true }],
          "description": "Planning poker: estimators answer blind; the facilitator reveals and settles both estimates; unclear items go to research first."
        },
        "done": { "terminal": true }
      },
      "transitions": [
        { "from": "open", "to": "estimating", "actions": ["spawn.owner"] },
        {
          "from": "estimating",
          "to": "done",
          "guards": [{ "guard": "estimates.present", "scope": "parent-members", "dimensions": ["complexity", "duration"] }]
        }
      ]
    },
    "planning": {
      "initial": "open",
      "states": {
        "open": { "owner": "scrum-orchestrator" },
        "selecting": { "owner": "product-owner", "description": "Rank by value, then by the complexity-duration matrix; link items to the sprint up to capacity." },
        "committed": { "terminal": true }
      },
      "transitions": [
        { "from": "open", "to": "selecting", "actions": ["spawn.owner"] },
        { "from": "selecting", "to": "committed", "guards": [{ "guard": "capacity", "dimension": "complexity", "scope": "parent" }] }
      ]
    },
    "retro": {
      "initial": "open",
      "states": {
        "open": { "owner": "facilitator" },
        "analysing": { "owner": "facilitator", "description": "Estimate against actual; name what slowed the sprint." },
        "done": { "terminal": true }
      },
      "transitions": [
        { "from": "open", "to": "analysing", "actions": [{ "action": "compute.velocity", "dimension": "complexity" }] },
        {
          "from": "analysing",
          "to": "done",
          "actions": [{ "action": "handoff", "to": "delivery-process", "create": "work-item", "from_outcome": "improvements" }]
        }
      ]
    }
  },
  "policy": {
    "capacity": [{ "container": "sprint", "dimension": "complexity", "max": 100 }],
    "goals": { "orchestrator_goal": "sprint" }
  }
}
